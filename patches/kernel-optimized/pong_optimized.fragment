# Optimized Pong kernel — defconfig fragment
#
# Merge over the base defconfig, e.g.:
#   scripts/kconfig/merge_config.sh -m arch/arm64/configs/<base>_defconfig \
#       patches/kernel-optimized/pong_optimized.fragment
#
# Base tree assumption: arter97 r45b2 (5.10.251). It is the only surveyed
# kernel carrying both MGLRU and the built-in Qualcomm power stack — see
# device/kernels/README.md. Every line below states where it came from and
# whether it was verified.
#
# Legend: [have] already in the base, asserted so a tree change can't
#         silently drop it.  [add] new vs the base.  [check] needs
#         verification against the tree before building.

# ---------------------------------------------------------------------------
# Memory reclaim
# ---------------------------------------------------------------------------
# [have] MGLRU. Verified present in arter97 r45b2 (lru_gen, lru_gen_full,
# min_ttl_ms, and the lru_gen_init() sysfs-group printk). NOT in ACK
# android12-5.10 — Google put it on android13-5.10 — so on any other base
# this needs the mm/ patch series first, and the symbol alone does nothing.
# _ENABLED makes it on-by-default instead of requiring the sysfs toggle.
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y

# [add] DAMON. In ACK android12-5.10 already (Meteoric/LineageOS/Zixine all
# enable it); arter97 has zero DAMON symbols, so this is a real addition.
# PADDR without VADDR is the correct pairing — DAMON_RECLAIM monitors the
# physical address space, not per-process virtual space.
CONFIG_DAMON=y
CONFIG_DAMON_PADDR=y
# CONFIG_DAMON_VADDR is not set
CONFIG_DAMON_RECLAIM=y

# [have] zram. Keep zstd. Writeback deliberately OFF: on a 12 GB device it
# buys little and adds storage-backed stalls (arter97's stated reasoning;
# the GKI-derived kernels leave ZRAM_WRITEBACK=y).
CONFIG_ZRAM=y
CONFIG_ZSMALLOC=y
# CONFIG_ZRAM_WRITEBACK is not set

# ---------------------------------------------------------------------------
# Qualcomm scheduler / power / thermal stack
# ---------------------------------------------------------------------------
# [have] Built-in on this base (verified: sched_walt printks, waltgov,
# memlat, LPM governor, adreno_tz, gpubw_mon, limits_dcvs). This is the
# actual perf/power machinery — GPU freq + bandwidth governors, memory
# latency governor, LMH thermal, CPU idle LPM. Asserted =y so a rebase onto
# a GKI tree (where these are =m in vendor_dlkm) is a loud failure, not a
# silent behaviour change.
# [check] exact symbol names against the tree — these are CLO/vendor symbols
# and drift between bases.
CONFIG_SCHED_WALT=y
CONFIG_QCOM_MEMLAT=y
CONFIG_CPU_IDLE_GOV_QCOM_LPM=y
CONFIG_DEVFREQ_GOV_QCOM_ADRENO_TZ=y
CONFIG_DEVFREQ_GOV_QCOM_GPUBW_MON=y
CONFIG_QTI_THERMAL_LIMITS_DCVS=y
CONFIG_ARM_QCOM_CPUFREQ_HW=y
CONFIG_QTI_CPUFREQ_CDEV=y
CONFIG_QTI_DEVFREQ_CDEV=y
CONFIG_BUS_AUTO_SUSPEND=y

# [have] EAS. Unchanged from stock and every surveyed kernel — schedutil +
# uclamp + energy model is already the right setup; no governor swap.
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_UCLAMP_TASK=y
CONFIG_UCLAMP_TASK_GROUP=y
CONFIG_ENERGY_MODEL=y

# ---------------------------------------------------------------------------
# Network
# ---------------------------------------------------------------------------
# [add] BBR as default. Present but not default on this base. Zixine goes
# further and compiles cubic out entirely; cubic is kept here as a fallback
# so congestion control stays switchable at runtime.
CONFIG_TCP_CONG_BBR=y
CONFIG_DEFAULT_BBR=y
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_TCP_CONG_CUBIC=y
CONFIG_NET_SCH_FQ_CODEL=y

# ---------------------------------------------------------------------------
# Hardening — deliberately unchanged
# ---------------------------------------------------------------------------
# Nothing in the survey disables these, and the "custom kernels turn
# mitigations off for speed" claim was checked and is false for all 17.
# KASAN_HW_TAGS is MTE-based and boot-gated, so it is near-free when off;
# removing it buys nothing. Asserted to prevent a well-meaning "perf" edit.
CONFIG_CPU_MITIGATIONS=y
CONFIG_ARM64_ERRATUM_3194386=y
CONFIG_CFI_CLANG=y
CONFIG_SHADOW_CALL_STACK=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_KASAN_HW_TAGS=y
CONFIG_HARDENED_USERCOPY=y
CONFIG_INIT_STACK_ALL_ZERO=y

# ---------------------------------------------------------------------------
# Codegen
# ---------------------------------------------------------------------------
# FullLTO over ThinLTO — build time is not the constraint here.
# O2, not O3: the kernel is validated at O2, O3 inflates I-cache footprint,
# and no surveyed kernel that felt fast was using it.
CONFIG_LTO_CLANG=y
CONFIG_LTO_CLANG_FULL=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y

# ---------------------------------------------------------------------------
# Deliberately NOT changed
# ---------------------------------------------------------------------------
# HZ: left at 250 (stock and 16 of 17 kernels). Zixine alone uses 300 with
# no published benchmark. Change it only with a measurement behind it.
CONFIG_HZ_250=y
CONFIG_HZ=250

# Debug surface: DEBUG_INFO has no runtime cost (stripped from the loaded
# Image), KALLSYMS_ALL costs memory not CPU, SLUB_DEBUG is inert without
# slub_debug=. Trimming them is cargo-cult. DEBUG_LIST is the one with a
# real (small) runtime cost — left on; disable only if profiling says so.
